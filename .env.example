# Variables del despliegue. Copia este archivo a .env.local para desarrollo y
# defínelas en Vercel (Settings → Environment Variables) para producción.
#
# Los valores de abajo son de EJEMPLO pero válidos a propósito: si alguien los
# importa tal cual, el build pasa. Una variable creada con valor vacío también
# es tolerada — se usa el valor por defecto y queda un aviso en el log.
#
# Ojo: las NEXT_PUBLIC_* se incrustan en el bundle en tiempo de BUILD. Cambiar
# cualquiera de las dos exige volver a desplegar, no basta con guardarla.

# Dominio público del sitio. Absoluto, con http:// o https://.
# La barra final es opcional: se recorta sola.
# Lo consumen metadataBase, la imagen Open Graph, el sitemap, el robots.txt y el
# JSON-LD. Si falta o no es una URL válida, se usa https://taptag.mx.
NEXT_PUBLIC_SITE_URL=https://ejemplo.com

# Número de WhatsApp de ventas: código de país + número. Para México, 52 seguido
# de 10 dígitos. Se aceptan espacios, guiones, paréntesis y "+": se limpian solos.
# Si falta o no son entre 8 y 15 dígitos, los CTA apuntan al placeholder
# 52XXXXXXXXXX, que no es marcable y se nota de inmediato.
NEXT_PUBLIC_WHATSAPP_NUMBER=523312345678
