# Variables del despliegue. Copia este archivo a .env.local para desarrollo y
# defínelas en Vercel (Project Settings → Environment Variables) para producción.
#
# Ojo: las NEXT_PUBLIC_* se incrustan en el bundle en tiempo de BUILD. Cambiar
# cualquiera de las dos exige volver a desplegar, no basta con guardarla.

# Dominio público del sitio, con protocolo y sin barra final.
# Lo consumen metadataBase, la imagen Open Graph, el sitemap, el robots.txt y el
# JSON-LD. Si falta, se usa el valor por defecto de lib/constants.ts.
NEXT_PUBLIC_SITE_URL=https://ejemplo.com

# Número de WhatsApp de ventas: código de país + número, sin "+" ni espacios.
# Para México son 52 seguido de 10 dígitos.
# Si falta, todos los CTA quedan apuntando al placeholder 52XXXXXXXXXX.
NEXT_PUBLIC_WHATSAPP_NUMBER=521234567890
